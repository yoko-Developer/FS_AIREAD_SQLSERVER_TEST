<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<log4net>

		<appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender" >
			<layout type="log4net.Layout.PatternLayout">
				<ConversionPattern value="%date  [%-5level]  - %message%newline" />
			</layout>
		</appender>

		<!-- CallSetFixedAssetAccountCodeBatch -->
		<appender name="CallSetFixedAssetAccountCodeBatch" type="log4net.Appender.RollingFileAppender">
			<rollingStyle value="Date" />
			<staticLogFileName value="false" />
			<file value="C:/AIRead_ETL/logs/CallSetFixedAssetAccountCodeBatch-" />
			<DatePattern value='yyyy-MM-dd".log"' />
			<appendToFile value="true" />
			<Encoding value="utf-8" />
			<filter type="log4net.Filter.LevelRangeFilter">
				<param name="LevelMin" value="INFO" />
				<param name="LevelMax" value="Error" />
			</filter>
			<layout type="log4net.Layout.PatternLayout">
				<ConversionPattern value="%date  [%-5level]  - %message%newline" />
			</layout>
		</appender>

		<root>
			<level value="ALL" />
			<appender-ref ref="ConsoleAppender" />
			<appender-ref ref="CallSetFixedAssetAccountCodeBatch" />
		</root>

	</log4net>
</configuration>
